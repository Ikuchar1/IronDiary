    {
      "name": "Same-Day Rules (Postgres day-grained)",
      "description": "ADR-0002 same-day invariants, exercised with DIFFERENT times on the SAME calendar day so they actually prove the `.Date` day-grained comparison works on real PostgreSQL (Npgsql) — something the SQLite integration tests cannot confirm. Run against a live API pointed at Postgres. Self-contained: logs in, creates its own data on far-future (2099) dates, asserts, and cleans up after itself.",
      "item": [
        {
          "name": "SDR Setup — Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
            "pm.environment.set('token', pm.response.json().token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"{{test_email}}\", \"password\": \"{{test_password}}\"}" },
            "url": { "raw": "{{base_url}}/api/Auth/login", "host": ["{{base_url}}"], "path": ["api", "Auth", "login"] }
          }
        },
        {
          "name": "SDR A1 — Create Workout 08:00 (2099-01-10)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Workout created (200)', function () { pm.response.to.have.status(200); });",
            "pm.environment.set('sdr_w1', pm.response.json().workout.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"type\": \"Push\", \"description\": \"SDR A\", \"date\": \"2099-01-10T08:00:00Z\"}" },
            "url": { "raw": "{{base_url}}/api/WorkoutLog", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog"] }
          }
        },
        {
          "name": "SDR A2 — Rest Day same day 20:00 → 409 (day-grained collide)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Rest Day on a workout day is rejected (409)', function () { pm.response.to.have.status(409); });",
            "pm.test('409 carries a displayable message', function () { pm.expect(pm.response.text()).to.include('Rest Day'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"date\": \"2099-01-10T20:00:00Z\", \"note\": \"different time, same day\"}" },
            "url": { "raw": "{{base_url}}/api/RestDay", "host": ["{{base_url}}"], "path": ["api", "RestDay"] }
          }
        },
        {
          "name": "SDR A3 — Cleanup: delete workout",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Cleanup workout deleted', function () { pm.expect([204, 404]).to.include(pm.response.code); });"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog/{{sdr_w1}}", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog", "{{sdr_w1}}"] }
          }
        },
        {
          "name": "SDR B1 — Create Rest Day 22:00 (2099-02-10)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Rest Day created (200)', function () { pm.response.to.have.status(200); });",
            "pm.environment.set('sdr_r1', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"date\": \"2099-02-10T22:00:00Z\", \"note\": \"SDR B\"}" },
            "url": { "raw": "{{base_url}}/api/RestDay", "host": ["{{base_url}}"], "path": ["api", "RestDay"] }
          }
        },
        {
          "name": "SDR B2 — Workout same day 06:00 overrides Rest Day (overrodeRestDay true)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Workout created (200)', function () { pm.response.to.have.status(200); });",
            "pm.test('overrodeRestDay is true (same day, different time)', function () { pm.expect(pm.response.json().overrodeRestDay).to.be.true; });",
            "pm.environment.set('sdr_w2', pm.response.json().workout.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"type\": \"Legs\", \"description\": \"SDR B\", \"date\": \"2099-02-10T06:00:00Z\"}" },
            "url": { "raw": "{{base_url}}/api/WorkoutLog", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog"] }
          }
        },
        {
          "name": "SDR B3 — Rest Day gone after override",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Get rest days returns 200', function () { pm.response.to.have.status(200); });",
            "var dates = pm.response.json().map(function (r) { return r.date; }).join(',');",
            "pm.test('No Rest Day remains on 2099-02-10', function () { pm.expect(dates).to.not.include('2099-02-10'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/RestDay", "host": ["{{base_url}}"], "path": ["api", "RestDay"] }
          }
        },
