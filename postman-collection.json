{
  "info": {
    "name": "IronDiary API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Register a test user (tolerates 'already exists') and log in to capture the JWT into {{token}}. Run this first — every other folder needs the token.",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Register succeeds or user already exists', function () {",
            "  pm.expect([200, 400]).to.include(pm.response.code);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"{{test_email}}\", \"password\": \"{{test_password}}\"}" },
            "url": { "raw": "{{base_url}}/api/Auth/register", "host": ["{{base_url}}"], "path": ["api", "Auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Response contains token', function () {",
            "  var json = pm.response.json();",
            "  pm.expect(json.token).to.be.a('string').and.not.empty;",
            "  pm.environment.set('token', json.token);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"{{test_email}}\", \"password\": \"{{test_password}}\"}" },
            "url": { "raw": "{{base_url}}/api/Auth/login", "host": ["{{base_url}}"], "path": ["api", "Auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Workout Logs",
      "description": "CRUD smoke test for /api/WorkoutLog against the real stack. Note: POST/PUT return WorkoutLogWriteResultDto ({ workout, overrodeRestDay }), so the id lives at json.workout.id. Self-contained: creates a workout on 2026-03-25, reads it back, then deletes it.",
      "item": [
        {
          "name": "Create Workout Log",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Create workout log returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Response wraps workout + overrodeRestDay flag', function () {",
            "  var json = pm.response.json();",
            "  pm.expect(json.workout.id).to.be.a('number');",
            "  pm.expect(json.workout.type).to.eql('Push');",
            "  pm.expect(json.overrodeRestDay).to.be.a('boolean');",
            "  pm.environment.set('workout_log_id', json.workout.id);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"type\": \"Push\", \"description\": \"Test push day\", \"date\": \"2026-03-25T10:00:00Z\"}" },
            "url": { "raw": "{{base_url}}/api/WorkoutLog", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog"] }
          }
        },
        {
          "name": "Get All Workout Logs",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Get workout logs returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog"] }
          }
        },
        {
          "name": "Get Workout Log By ID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Get workout log by ID returns 200', function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog/{{workout_log_id}}", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog", "{{workout_log_id}}"] }
          }
        },
        {
          "name": "Get Workout Logs By Date Range",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Get workout logs by date range returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog/range?startDate=2026-01-01T00:00:00Z&endDate=2026-12-31T23:59:59Z", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog", "range"], "query": [{ "key": "startDate", "value": "2026-01-01T00:00:00Z" }, { "key": "endDate", "value": "2026-12-31T23:59:59Z" }] }
          }
        },
        {
          "name": "Delete Workout Log",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Delete workout log returns 204', function () { pm.response.to.have.status(204); });"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog/{{workout_log_id}}", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog", "{{workout_log_id}}"] }
          }
        }
      ]
    },
