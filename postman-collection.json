          "name": "SDR B4 — Cleanup: delete workout",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Cleanup workout deleted', function () { pm.expect([204, 404]).to.include(pm.response.code); });"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/WorkoutLog/{{sdr_w2}}", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog", "{{sdr_w2}}"] }
          }
        },
        {
          "name": "SDR C1 — Create Workout 09:00 (2099-03-10)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Workout created (200)', function () { pm.response.to.have.status(200); });",
            "pm.environment.set('sdr_w3', pm.response.json().workout.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"type\": \"Push\", \"description\": \"SDR C\", \"date\": \"2099-03-10T09:00:00Z\"}" },
            "url": { "raw": "{{base_url}}/api/WorkoutLog", "host": ["{{base_url}}"], "path": ["api", "WorkoutLog"] }
          }
        },
        {
          "name": "SDR C2 — Rest Day on the NEXT day is allowed (200, negative control)",
          "event": [{ "listen": "test", "script": { "exec": [
